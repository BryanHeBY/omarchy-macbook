{
  "input_method": "caps-fn",
  "features": {
    "workspace-navigation": true,
    "tab-shortcuts": true,
    "desktop-shortcuts": true,
    "screenshot-shortcuts": false,
    "chinese-fonts": true,
    "keyboard-input": true,
    "menu-selection-memory": true,
    "system-tray": true,
    "window-focus-gestures": false,
    "touchpad-scrolling": true,
    "touchpad-inertia": false,
    "display-controls": false,
    "passwordless-lock": false,
    "vscode-scrolling": false
  }
}
