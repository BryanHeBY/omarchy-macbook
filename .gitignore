# Python bytecode caches and temporary editor files.
__pycache__/
*.pyc
*~
*.bak
*.bak.*

# Credentials and local session data belong in their private directories.
.env
.env.*
id_rsa*
id_ed25519*
*.key
*.pem

# Native plugins are compiled for each installed Hyprland version.
*.so

# Runtime records and build intermediates stay outside version control.
*.o
*.log
menu-history.json
